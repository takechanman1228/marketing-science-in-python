# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipython/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# Reader-generated outputs (recreated by running the notebooks)
images/
tables/
artifacts/

# Raw datasets: readers download these locally (see data/raw/README.md)
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep

# Generated data: ignore by default, but keep the committed seed datasets
# the notebooks depend on.
data/generated/**/*
!data/generated/**/
!data/generated/**/README.md
!data/generated/part4/sec4.1-segmentation/segment_assignments.csv
!data/generated/part5/sec5.3-demand-forecast/dunnhumby_grocery_weekly.parquet
